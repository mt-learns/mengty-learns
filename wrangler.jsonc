{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mengty-learns",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Must match "name" above (OpenNext uses it for internal requests)
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mengty-learns"
    }
  ],
  // Production hostname. To use another subdomain, change it here only.
  // Needs the limmengty.com zone in the same Cloudflare account; Cloudflare
  // creates the DNS record and certificate.
  "routes": [{ "pattern": "learn.limmengty.com", "custom_domain": true }],
  // Keep *.workers.dev (and version preview URLs) for PR previews.
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true }
}
